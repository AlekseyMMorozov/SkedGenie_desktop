# .gitignore для SkedGenie_desktop
# Язык: Python | UI: PySide6 | БД: SQLite+aiosqlite | Архитектура: Onion

# =============================================================================
# PYTHON
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/

# Виртуальные окружения
.venv/
venv/
ENV/
env/
.venv-windows/
.venv-linux/

# Инструменты
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
.pyre/

# =============================================================================
# БАЗЫ ДАННЫХ (SQLite + aiosqlite)
# =============================================================================
# Файлы БД и временные журналы SQLite
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Папка данных для dev-режима (если не отслеживается структура)
data/*
!data/.gitkeep

# =============================================================================
# СРЕДА И СЕКРЕТЫ
# =============================================================================
# Файлы конфигурации с чувствительными данными
.env
*.env
.env.local
.env.*.local
*.secret
config.local.py
settings.local.json

# =============================================================================
# IDE И РЕДАКТОРЫ
# =============================================================================
# VS Code
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# =============================================================================
# ОПЕРАЦИОННЫЕ СИСТЕМЫ
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.Spotlight-V100/
.Trashes/

# =============================================================================
# ЛОГИ И ВРЕМЕННЫЕ ФАЙЛЫ
# =============================================================================
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp

# =============================================================================
# ПРОЕКТ-СПЕЦИФИЧНОЕ
# =============================================================================
# Артефакты сборки и дистрибуции
dist/
build/
*.spec

# Кэш Qt / PySide6
*.qm
*.qrc
*.ui~

# Документация (если генерируется)
docs/_build/
site/

# Тестовые артефакты
test_results/
*.coverage.*

# =============================================================================
# РАЗРЕШЁННЫЕ ИСКЛЮЧЕНИЯ (не игнорировать)
# =============================================================================
# Сохраняем структуру папок через .gitkeep
!data/.gitkeep
!config/.gitkeep
!tests/.gitkeep
